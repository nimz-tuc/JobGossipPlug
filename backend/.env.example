# Copy to .env for local use. On Render, enter these in the service's Environment tab instead (no .env file there).
PORT=5000
NODE_ENV=development
# At least 32 random characters. Required: the server refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Database: on Render just set DATABASE_URL (copy the "Internal Database URL" of your NEW Postgres). Locally use the DB_* values.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobplug
DB_USER=postgres
DB_PASSWORD=

# Render: set NODE_ENV=production and TRUST_PROXY=1
TRUST_PROXY=
# One-time: AFTER you have registered on the site, put your email here and redeploy to become admin, then delete this line.
ADMIN_EMAIL=
# Your own contact address, shown on the Privacy page.
SUPPORT_EMAIL=
